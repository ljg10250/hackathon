{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kongju-hackathon-jabjapda",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "vars": {
    "SUPABASE_URL": "https://jlnebtxrncfqzyjgasuw.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_-wEkACnUhKu8an21bXq1jA_hmFvAi8U"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": false
  }
}
